{
  "info": {
    "name": "DATA_PLATFORM",
    "description": "데이터 플랫폼 백엔드 API. 먼저 컬렉션 Variables 에 baseUrl 과 system_id 를 넣으십시오.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. 시스템",
      "item": [
        {
          "name": "시스템 목록",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/systems",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "systems"
              ]
            },
            "description": "등록된 시스템(대상 DB) 목록입니다. 다른 요청에 쓸 system_id 를 여기서 찾습니다."
          },
          "response": []
        },
        {
          "name": "시스템 등록",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/systems",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "systems"
              ]
            },
            "description": "대상 DB 접속 정보를 등록합니다.\n\n- code: 영문 짧은 이름\n- name: 화면에 보일 이름\n- domain_desc: 업무 설명 (LLM 이 참고)\n- driver: mysql, postgresql, oracle 중 하나\n- port: 0 이면 드라이버 기본 포트\n- db_schemas: 읽을 스키마 목록. 첫 스키마가 기본 스키마이고, 나머지 스키마의 테이블은 '스키마.테이블' 이름이 됩니다. 비우면 PostgreSQL 은 public, Oracle 은 접속 계정 (MySQL 은 db_name 하나만 읽습니다)",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"shop\",\n  \"name\": \"쇼핑몰\",\n  \"domain_desc\": \"주문과 회원을 다루는 쇼핑몰 DB\",\n  \"driver\": \"postgresql\",\n  \"host\": \"localhost\",\n  \"port\": 0,\n  \"db_name\": \"shop\",\n  \"db_schemas\": [\n    \"public\"\n  ],\n  \"username\": \"\",\n  \"password\": \"\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "시스템 조회",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/systems/{{system_id}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "systems",
                "{{system_id}}"
              ]
            },
            "description": "시스템 하나의 정보입니다."
          },
          "response": []
        },
        {
          "name": "시스템 수정",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/systems/{{system_id}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "systems",
                "{{system_id}}"
              ]
            },
            "description": "시스템 정보를 고칩니다. password 를 비워 보내면 기존 비밀번호를 그대로 둡니다.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"shop\",\n  \"name\": \"쇼핑몰\",\n  \"domain_desc\": \"주문과 회원을 다루는 쇼핑몰 DB\",\n  \"driver\": \"postgresql\",\n  \"host\": \"localhost\",\n  \"port\": 0,\n  \"db_name\": \"shop\",\n  \"db_schemas\": [\n    \"public\"\n  ],\n  \"username\": \"\",\n  \"password\": \"\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "시스템 삭제",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/systems/{{system_id}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "systems",
                "{{system_id}}"
              ]
            },
            "description": "시스템을 지웁니다."
          },
          "response": []
        },
        {
          "name": "스키마 동기화",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/systems/{{system_id}}/sync",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "systems",
                "{{system_id}}",
                "sync"
              ]
            },
            "description": "대상 DB 에서 테이블과 컬럼 정보를 읽어 저장된 스키마에 합칩니다. 결과로 추가, 변경, 삭제 건수가 옵니다."
          },
          "response": []
        },
        {
          "name": "동기화 기록",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/sync-logs?limit=100",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "sync-logs"
              ],
              "query": [
                {
                  "key": "system_id",
                  "value": "",
                  "description": "이 시스템 것만 봅니다. 비우면 전체",
                  "disabled": true
                },
                {
                  "key": "limit",
                  "value": "100",
                  "description": "최대 건수",
                  "disabled": false
                }
              ]
            },
            "description": "스키마 동기화를 언제 했고 무엇이 바뀌었는지 봅니다."
          },
          "response": []
        }
      ]

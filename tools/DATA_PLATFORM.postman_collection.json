    {
      "name": "2. 테이블 설정",
      "item": [
        {
          "name": "저장된 스키마",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/systems/{{system_id}}/schema",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "systems",
                "{{system_id}}",
                "schema"
              ]
            },
            "description": "저장된 테이블과 컬럼, 설명입니다. 대상 DB 에서 사라진 것은 빠집니다."
          },
          "response": []
        },
        {
          "name": "테이블 목록",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/systems/{{system_id}}/tables",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "systems",
                "{{system_id}}",
                "tables"
              ]
            },
            "description": "테이블마다 용도, 컬럼 설명, UTC 보정, 계산 필요 표시 같은 설정을 함께 돌려줍니다. table_id 를 여기서 찾습니다.\n\n컬럼 설명은 셋입니다. note 는 사람이 적은 설명, comment 는 대상 DB 코멘트, ai_comment 는 LLM 이 추론한 설명이며 LLM 에는 이 순서로 앞의 것을 넘깁니다."
          },
          "response": []
        },
        {
          "name": "테이블 용도 저장",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/systems/{{system_id}}/tables/{{table_id}}/purpose",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "systems",
                "{{system_id}}",
                "tables",
                "{{table_id}}",
                "purpose"
              ]
            },
            "description": "사람이 적는 테이블 용도입니다. 질문에 맞는 테이블을 고를 때 LLM 이 참고합니다.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"purpose\": \"\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "컬럼 설명 저장",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/systems/{{system_id}}/tables/{{table_id}}/column-note",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "systems",
                "{{system_id}}",
                "tables",
                "{{table_id}}",
                "column-note"
              ]
            },
            "description": "사람이 적는 컬럼 설명입니다. 대상 DB 코멘트와 추론한 설명보다 먼저 쓰이고, 동기화나 자동 설명이 지우지 않습니다. note 를 빈 문자열로 보내면 원래 설명(DB 코멘트나 추론한 설명)으로 돌아갑니다.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"column\": \"user_id\",\n  \"note\": \"로그인 아이디\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "시각 컬럼 UTC 보정",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/systems/{{system_id}}/tables/{{table_id}}/utc-offset",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "systems",
                "{{system_id}}",
                "tables",
                "{{table_id}}",
                "utc-offset"
              ]
            },
            "description": "DB 가 시각을 UTC 로 저장할 때 현지 시차를 적습니다 (한국은 9). utc_offset_hours 를 0 이나 null 로 보내면 보정을 끕니다.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"column\": \"created_at\",\n  \"utc_offset_hours\": 9\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "계산 필요 컬럼 표시",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/systems/{{system_id}}/tables/{{table_id}}/needs-calc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "systems",
                "{{system_id}}",
                "tables",
                "{{table_id}}",
                "needs-calc"
              ]
            },
            "description": "누적값처럼 그대로 더하면 틀리는 컬럼에 표시합니다. 질문 처리와 지표 자동 등록이 이 표시를 참고합니다.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"column\": \"odometer\",\n  \"needs_calc\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "설명 자동 채우기 시작",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/systems/{{system_id}}/describe/runs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "systems",
                "{{system_id}}",
                "describe",
                "runs"
              ]
            },
            "description": "설명이 빈 테이블과 컬럼을 LLM 이 이름, 타입, 샘플 값 몇 행을 보고 채우고(ai_comment), 컬럼 이름, 타입, PK 로 관계도 추론합니다(source 가 auto 인 관계). 뒤에서 돌고 바로 실행 id 를 돌려줍니다.\n\n- table_ids: 비우면 설명이 빈 테이블 모두\n- descriptions: 빈 설명을 채웁니다\n- overwrite: 전에 추론한 설명도 다시 채웁니다. DB 코멘트와 사람이 적은 설명은 언제나 그대로 둡니다\n- relations: 관계를 추론합니다",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"table_ids\": [],\n  \"descriptions\": true,\n  \"overwrite\": false,\n  \"relations\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "설명 자동 채우기 기록",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/systems/{{system_id}}/describe/runs?limit=50",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "systems",
                "{{system_id}}",
                "describe",
                "runs"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "50",
                  "description": "최대 건수",
                  "disabled": false
                }
              ]
            },
            "description": "설명 자동 채우기를 돌린 기록입니다."
          },
          "response": []
        },
        {
          "name": "설명 자동 채우기 결과",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/systems/{{system_id}}/describe/runs/{{run_id}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "systems",
                "{{system_id}}",
                "describe",
                "runs",
                "{{run_id}}"
              ]
            },
            "description": "진행 상황과 채운 건수, 실패한 테이블입니다. status 가 running 이면 아직 도는 중이니 다시 불러 보십시오."
          },
          "response": []
        }
      ]
    },

# ---------- 비밀정보 ----------
# 모든 .env는 무시하고, 자리표시자만 담은 템플릿 하나만 커밋한다.
.env
.env.*
!.env.example

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# 빌드 산출물. 앞의 /는 저장소 최상위만 가리킨다 —
# 이것이 없으면 소스 안의 같은 이름 폴더까지 함께 숨는다.
/build/
/dist/
/sdist/
/develop-eggs/
/downloads/
/eggs/
/.eggs/
/parts/
/var/
/wheels/
*.egg-info/
*.egg
.installed.cfg

# 가상환경
.venv/
venv/
ENV/

# 테스트·린트 캐시
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/

# ---------- 프론트엔드 ----------
node_modules/
dist/
dist-ssr/
.vite/
*.local

# ---------- 로그 ----------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---------- 편집기 ----------
.idea/
.vscode/
*.swp
*.swo
*~

# ---------- OS ----------
.DS_Store
Thumbs.db
desktop.ini

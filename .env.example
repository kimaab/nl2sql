# 이 파일을 backend/.env로 복사한 뒤 실제 값을 채우십시오.
# backend/.env는 .gitignore에 걸려 있어 커밋되지 않습니다.

# 메타데이터 DB (PostgreSQL) — 이 앱이 데이터소스 목록·스키마·지표를 쌓는 곳
# 비밀번호에 @ : / # 같은 문자가 있으면 URL 인코딩해야 합니다 (# 은 %23).
DB_URL=postgresql://USER:PASSWORD@localhost:5432/nl2sql

# LLM (OpenAI 호환 엔드포인트)
LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=sk-...
LLM_MODEL=model-name

# 지표 의미 검색 (선택). 비워 두면 꺼지고 TF-IDF 만 쓴다.
# 켜려면: uv sync --extra embedding, 메타데이터 DB 에 pgvector 확장 필요.
# 모델은 첫 실행 때 내려받는다 (bge-m3 약 2.3GB).
# EMBED_MODEL=BAAI/bge-m3
# EMBED_MIN_SCORE=0.5      # 이보다 덜 비슷한 지표는 후보에서 뺀다
# EMBED_DEVICE=cpu         # 비우면 자동 (GPU 가 있으면 cuda)

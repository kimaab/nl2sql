# 이 파일을 backend/.env로 복사한 뒤 실제 값을 채우십시오.
# backend/.env는 .gitignore에 걸려 있어 커밋되지 않습니다.

# 메타데이터 DB (PostgreSQL) — 이 앱이 데이터소스 목록·스키마·지표를 쌓는 곳
# 비밀번호에 @ : / # 같은 문자가 있으면 URL 인코딩해야 합니다 (# 은 %23).
DB_URL=postgresql://USER:PASSWORD@localhost:5432/nl2sql

# 대상 DB 비밀번호 암호화 키 (32바이트 base64). 없으면 기동하지 않습니다. 잃으면 비밀번호를 다시 입력해야 합니다.
# 만들기: python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
NL2SQL_SECRET_KEY=

# LLM (OpenAI 호환 엔드포인트)
LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=sk-...
LLM_MODEL=model-name

# 국토교통부 아파트 매매 실거래가 수집 (collect/budongsan/budongsan.py)
# 공공데이터포털에서 '국토교통부_아파트 매매 실거래가 자료' 활용신청 후 발급
# 일반 인증키(Decoding/Encoding 모두 지원). 이 값은 커밋하지 않습니다.
MOLIT_SERVICE_KEY=
# 행정안전부_행정표준코드_법정동코드 활용신청이 승인된 인증키
# 설정하면 거래 수집 전에 전국 법정동코드 목록을 갱신합니다.
MOIS_SERVICE_KEY=
# 지역명으로 선택 (법정동 API 키 필요). 예: 서울특별시 또는 경기도 수원시 또는 전국
# BUDONGSAN_LAWD_CODES와 둘 중 하나만 설정합니다.
BUDONGSAN_REGIONS=
# 수집할 법정동코드 앞 5자리, 쉼표 구분. 예: 11110,11680 (종로구, 강남구)
BUDONGSAN_LAWD_CODES=
# 기본: 현재 DB_URL에 budongsan 스키마 생성. 별도 DB이면 아래 설정
BUDONGSAN_DB_URL=
# 매일 당월 포함 최근 3개월 재수집 (지연 신고/정정/해제 반영)
BUDONGSAN_LOOKBACK_MONTHS=3

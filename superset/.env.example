# 이 파일을 .env 로 복사한 뒤 값을 채우십시오. .env 는 .gitignore 에 걸려 커밋되지 않습니다.

# 세션·비밀번호 암호화 키. 잃으면 Superset 에 저장한 DB 접속 비밀번호를 다시 입력해야 합니다.
# 만들기: python -c "import secrets; print(secrets.token_urlsafe(42))"
SUPERSET_SECRET_KEY=

# 메타데이터 DB — nl2sql-db 와 같은 PostgreSQL 서버. superset 데이터베이스는 superset-init 이 만듭니다.
SUPERSET_DB_HOST=host.docker.internal
SUPERSET_DB_PORT=5432
SUPERSET_DB_USER=postgres
SUPERSET_DB_PASSWORD=
SUPERSET_DB_NAME=superset

# 첫 관리자 계정 (superset-init 이 만듭니다)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# 이 파일을 .env 로 복사한 뒤 값을 채우십시오. .env 는 .gitignore 에 걸려 커밋되지 않습니다.

# 세션·비밀번호 암호화 키. 잃으면 Superset 에 저장한 DB 접속 비밀번호를 다시 입력해야 합니다.
# 만들기: python -c "import secrets; print(secrets.token_urlsafe(42))"
SUPERSET_SECRET_KEY=

# PostgreSQL (db 서비스) 계정 — nl2sql 메타데이터 DB 와 Superset 메타데이터 DB 가 같이 쓴다.
# 볼륨을 처음 만들 때만 적용된다. 이미 만든 볼륨의 비밀번호를 바꾸려면 DB 에서 ALTER USER 로 바꾼다.
# backend/.env 의 DB_URL 도 같은 계정이다.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# HTTPS 인증서에 넣을 접속 주소 (호스트 이름과 IP, 쉼표 구분). 여기 없는 주소로 접속하면 브라우저가 막습니다.
# 바꾼 뒤 docker compose up -d 하면 superset-init 이 서버 인증서를 다시 만듭니다 (CA 는 그대로).
SUPERSET_TLS_HOSTS=localhost,127.0.0.1

# 첫 관리자 계정 (superset-init 이 만듭니다)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
